# Copy this file to .env.local and fill in the three values.
# .env.local is git-ignored — it never gets committed or published.
# Every value below comes from your Supabase project. See PHASE-1.md.

# Safe to be public. Row-level security is what protects the data.
# Accepts either an `sb_publishable_...` key or a legacy `anon` JWT key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Accepts either an `sb_secret_...` key or a legacy `service_role` JWT key.
# SECRET. Bypasses all security rules. Server-side only, used just for
# sending invitations and (Phase 5) looking up who a notification email
# goes to. Never paste this into a browser, a chat, or a file that gets
# committed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 5: email notifications (optional) ---
# Without these, assignments/mentions/comments/due-soon reminders still
# show up in-app, in Inbox — email is an add-on, not a requirement. See
# PHASE-5.md for the full setup.

# From resend.com → API Keys. SECRET.
RESEND_API_KEY=

# Who the emails appear to come from. Needs a domain verified in Resend
# (Domains → Add Domain) to actually deliver — until then, leave unset
# and Resend's own sandbox sender is used, which only reaches your own
# Resend account email.
EMAIL_FROM=

# A password you make up — any long random string. Pasted into both here
# and into the Supabase Database Webhook's Authorization header, so the
# webhook route can tell a real Supabase request from anyone else on the
# internet POSTing to it. SECRET.
TEAM_NOTIFY_WEBHOOK_SECRET=
